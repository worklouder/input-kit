{
  "name": "@worklouder/input-kit",
  "version": "0.1.0",
  "description": "Node.js client library for Work Louder Input",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/worklouder/input-kit.git"
  },
  "homepage": "https://github.com/worklouder/input-kit#readme",
  "bugs": {
    "url": "https://github.com/worklouder/input-kit/issues"
  },
  "keywords": [
    "work-louder",
    "input",
    "websocket",
    "client",
    "hardware",
    "macropad"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@1.22.22",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "yarn build && node --test",
    "example": "yarn build && node examples/cli.mjs",
    "prepack": "yarn build"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.9.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  }
}
