{
  "name": "@worklouder/input-kit",
  "version": "0.1.0",
  "description": "Node.js client library for Work Louder Input",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/worklouder/input-kit.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@1.22.22",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "example": "yarn build && node examples/cli.mjs",
    "prepack": "yarn build"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.9.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  }
}
